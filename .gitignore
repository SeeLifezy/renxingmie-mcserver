logs/
*.log
*.log.gz
world/
usercache.json
usernamecache.json
session.lock
level.dat_old

# ---------- 4. 模组二进制（不应入库）----------
mods/*.jar
mods/*.jar.disabled
libraries/**/*.jar
addons/**/*.zip

# ---------- 5. 备份与临时文件 ----------
*.bak
*.tmp
*.old

