.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*~

# ---------- 7. ServerPackCreator 临时产物 ----------
serverpackcreator.conf
serverpackcreator.db
serverpackcreator.tmp

